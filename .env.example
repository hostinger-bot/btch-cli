[TEMPLATE]
# btch API Configuration
BTCH_API_KEY=your_api_key_here

# Optional: Custom API base URL (default: https://ai.tioo.eu.org/v1)
# BTCH_BASE_URL=https://ai.tioo.eu.org/v1

# Optional: Default model (fetched automatically from the endpoint when unset)
# BTCH_MODEL=

# Optional: Max tokens per response (default: 16384)
# BTCH_MAX_TOKENS=16384

# Optional: Telegram bot token for /connect → Telegram (see README)
# TELEGRAM_BOT_TOKEN=123456:ABC...
